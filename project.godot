; Engine configuration file.
; Futbol 5 - proyecto Godot 4.7.2 (GL Compatibility, orientado a Android).

config_version=5

[application]

config/name="Futbol 5"
config/description="Juego original de futbol 5 / futsal con control asistido y fisicas propias."
run/main_scene="res://scenes/dev/dev_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=0
config/icon="res://icon.svg"

[autoload]

Tuning="*res://scripts/gameplay/tuning.gd"
GraphicsSettings="*res://scripts/diagnostics/graphics_settings.gd"
Sfx="*res://scripts/audio/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

